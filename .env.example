# ---- Shopify (from your app in the Shopify Dev Dashboard) ----
# Your store's myshopify address, without https://
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=paste-client-id-here
SHOPIFY_CLIENT_SECRET=paste-client-secret-here
SHOPIFY_API_VERSION=2025-10
# Optional: the location your stock lives at (gid://shopify/Location/123...).
# Leave empty to use your store's first location.
SHOPIFY_LOCATION_ID=

# ---- Dealer (ask your dealer for their API details) ----
DEALER_API_URL=https://api.your-dealer.com
DEALER_API_KEY=paste-dealer-api-key-here

# ---- App settings ----
PORT=3000
# How often to sync stock and tracking (cron format). Default: every 30 minutes.
SYNC_SCHEDULE=*/30 * * * *
# Set to true to test without actually sending orders to the dealer
DRY_RUN=true

# ---- AI agent (Anthropic API key from console.anthropic.com) ----
# Leave empty to run the app without the AI agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Password for the chat page at /chat (make it long and unique)
ADMIN_PASSWORD=
TIMEZONE=America/Chicago
SUMMARY_SCHEDULE=0 8 * * *
WATCH_SCHEDULE=15 * * * *
LOW_STOCK_THRESHOLD=5
# Days without tracking before an order counts as "stuck"
STUCK_DAYS=4

# ---- Email for summaries and alerts (optional; otherwise they go to the logs) ----
# Gmail example: smtp.gmail.com, port 465, your Gmail, and an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
